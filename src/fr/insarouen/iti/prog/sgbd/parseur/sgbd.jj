options {
  STATIC = false;
  IGNORE_CASE = true; // ignore la casse pour les mots-cle
}

PARSER_BEGIN(SGBDParser)

package fr.insarouen.iti.prog.sgbd.parseur;

import fr.insarouen.iti.prog.sgbd.modele.BaseDeDonnees;
import fr.insarouen.iti.prog.sgbd.modele.Table;
import fr.insarouen.iti.prog.sgbd.modele.Attribut;
import fr.insarouen.iti.prog.sgbd.modele.Type;
import fr.insarouen.iti.prog.sgbd.exceptions.TableExistanteException;
import fr.insarouen.iti.prog.sgbd.exceptions.TableInconnueException;
import java.util.ArrayList;
import java.util.List;

public class SGBDParser {

  /** notre base de données sur laquelle le parseur va directement exécuter ses commandes
   * au lieu de faire une nouvelle class Commandes et retourner des instances de celles ci
   */
  private BaseDeDonnees db;

  /**
   * Injecte la base de données cible
   * Doit etre appelé avant toute command
   */
  public void setDatabase(BaseDeDonnees database) {
      this.db = database;
  }
}

PARSER_END(SGBDParser)

/* =========================================================================
ANALYSE LEXICALE (Tokens)
   ========================================================================= */

// Espaces et commentaires à ignorer
SKIP : {
  " "
| "\t"
| "\n"
| "\r"
| < "--" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? > // tpous les ommentaires SQL débutant par --
}

// Mots-clés du SQL
TOKEN : {
  < CREATE: "CREATE" >
| < TABLE: "TABLE" >
| < DROP: "DROP" >
| < INSERT: "INSERT" >
| < INTO: "INTO" >
| < VALUES: "VALUES" >
| < DELETE: "DELETE" >
| < FROM: "FROM" >
| < WHERE: "WHERE" >
| < SELECT: "SELECT" >
| < AS: "AS" >
| < TABLES: "TABLES" >
| < EXIT: "EXIT" >
| < QUIT: "QUIT" >
| < AND: "AND" >
| < OR: "OR" >
}

// Types de données supportés
TOKEN : {
  < TYPE_INT: "INT" >
| < TYPE_SERIAL: "SERIAL" >
| < TYPE_VARCHAR: "VARCHAR" >
}

// Opérateurs et Ponctuation
TOKEN : {
  < SEMICOLON: ";" >
| < COMMA: "," >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < STAR: "*" >
| < OP_EQ: "=" >
| < OP_GT: ">" >
| < OP_LT: "<" >
}

// Identifiants et Valeurs (basés sur le tableau de la fin du sujet)
TOKEN : {
  < NUMBER: (["0"-"9"])+ >
| < STRING: "\"" (~["\""])* "\"" > // echaper les "
| < ID: (["a"-"z", "A"-"Z"]) (["a"-"z", "A"-"Z", "0"-"9", "_", "."])* >
}

/* =========================================================================
ANALYSE SYNTAXIQUE (Grammaire)
   ========================================================================= */

// Règle principale (Point d'entrée)
void Commande() :
{}
{
  (
    CommandeCreate()
  | CommandeInsert()
  | CommandeSelect()
  | CommandeDrop()
  | CommandeDelete()
  | CommandeTables()
  | CommandeExit()
  )
  <SEMICOLON>
}

// CREATE TABLE nom (col1 TYPE, col2 TYPE, ...)
void CommandeCreate() :
{
  Token nomTable;
  List<Attribut> schema = new ArrayList<>();
}
{
  <CREATE> <TABLE> nomTable=<ID>
  <LPAREN> Colonne(schema) ( <COMMA> Colonne(schema) )* <RPAREN>
  {
    Table t = new Table(nomTable.image, schema);
    try {
      db.creerTable(t);
      System.out.println("Table ''" + nomTable.image + "' créée.");
    } catch (TableExistanteException e) {
      System.err.println("[ERREUR] " + e.getMessage());
    }
  }
}

// Colonne : ajoute un Attribut dans le schema
void Colonne(List<Attribut> schema) :
{ 
  Token nomCol; 
  Type typeCol; 
}
{
  nomCol=<ID> typeCol=Type()
  { 
    schema.add(new Attribut(nomCol.image, typeCol)); 
  }
}

// Type : retourne le Type Java correspondant au mot-clé lu
Type Type() :
{}
{
  <TYPE_INT>     { return Type.INT; }
| <TYPE_SERIAL>  { return Type.SERIAL; }
| <TYPE_VARCHAR> { return Type.VARCHAR; }
}

// DROP TABLE nom
void CommandeDrop() :
{ 
  Token nomTable; 
}
{
  <DROP> <TABLE> nomTable=<ID>
  {
    try {
      db.supprimerTable(nomTable.image);
      System.out.println("Table '" + nomTable.image + "' supprimée.");
    } catch (TableInconnueException e) {
      System.err.println("[ERREUR] " + e.getMessage());
    }
  }
}

// TABLES : liste toutes les tables existantes
void CommandeTables() :
{}
{
  <TABLES>
  {
    List<String> tables = db.listerTables();
    if (tables.isEmpty()) {
      System.out.println("(Aucune table)");
    } else {
      System.out.println("Tables : " + tables);
    }
  }
}

// Placeholder pour DML et Sélection (à implémenter)
void CommandeInsert() :
{}
{
  <INSERT> <INTO> <ID> <LPAREN> <ID> ( <COMMA> <ID> )* <RPAREN>
  <VALUES> <LPAREN> Valeur() ( <COMMA> Valeur() )* <RPAREN>
}

void Valeur() :
{}
{
  <NUMBER> | <STRING>
}

void CommandeDelete() :
{}
{
  <DELETE> <FROM> <ID> ( <WHERE> ExpressionLogique() )?
}

void CommandeSelect() :
{}
{
  <SELECT> ( <STAR> | <ID> ( <COMMA> <ID> )* )
  <FROM> Source() ( <COMMA> Source() )*
  ( <WHERE> ExpressionLogique() )?
}

void Source() :
{}
{
  <ID> ( (<AS>)? <ID> )?
}

void CommandeExit() :
{}
{
  <EXIT> | <QUIT>
}

// Expressions logiques
void ExpressionLogique() :
{}
{
  ConditionSimple() ( (<AND> | <OR>) ConditionSimple() )*
}

void ConditionSimple() :
{}
{
  <ID> ( <OP_EQ> | <OP_GT> | <OP_LT> ) ( Valeur() | <ID> )
}
